rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // SECURITY: Deny all access.
    //
    // Verified 2026-07-24 (see docs/AUDIT.md): no application code reads or
    // writes Firestore. The transcriptions/documents/user_profile collections
    // are unused FlutterFlow scaffolding. The previous rules allowed
    // unauthenticated read/write/delete on all of them ("if true"), which was
    // an open door over PDPL-sensitive data.
    //
    // Closing everything now breaks nothing, because nothing uses it. When the
    // university platform is actually built, replace this with authenticated,
    // per-user rules — do NOT reopen with "if true".
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
