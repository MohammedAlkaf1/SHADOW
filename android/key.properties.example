# Copy this file to android/key.properties (git-ignored) and fill in real
# values pointing at your release keystore. NEVER commit key.properties or
# the .jks/.keystore file itself. See docs/RELEASE_SIGNING.md.
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyPassword=REPLACE_WITH_KEY_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
storeFile=REPLACE_WITH_ABSOLUTE_OR_RELATIVE_PATH_TO_KEYSTORE.jks
